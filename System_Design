Singleton design pattern:
=> This pattern ensures that one class will contain one object.
=> Here object is created when we call the constructor. So if we stop make call then object will not created, but the first object is created by exposing a method that will return the instance.

Ex:
public class Singleton
{
	private static Singleton instance;
	private Singleton(){}
	public static Singleton getInstance()
	{
		if(instance == null){
			instance = new Singleton();
		}
		return instance;
	}
}
public class Program
{
	public static void Main(string[] args)
	{
		Singleton s1 = Singleton.getInstance();
		Console.WriteLine(s1);

		Singleton s2 = Singleton.getInstance();
		Console.WriteLine(s2);
	}
}

